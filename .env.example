NODE_ENV=production
PORT=8787
VITE_REQUIRE_API=true
DATABASE_URL=postgres://eduquest:replace-this-db-password@db:5432/eduquest
POSTGRES_PASSWORD=replace-with-a-random-password-using-letters-numbers-dashes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
REGISTRATION_ENABLED=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Keep false for local http://localhost only; set true behind HTTPS in production.
COOKIE_SECURE=false
# Set to 1 only when the app is behind exactly one trusted HTTPS reverse proxy.
TRUST_PROXY=1
