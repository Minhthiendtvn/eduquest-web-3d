NODE_ENV=production
PORT=8787
VITE_REQUIRE_API=true
DATABASE_URL=postgres://eduquest:replace-this-db-password@db:5432/eduquest
POSTGRES_PASSWORD=replace-with-a-random-password-using-letters-numbers-dashes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
REGISTRATION_ENABLED=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Keep false for local http://localhost only; set true behind HTTPS in production.
COOKIE_SECURE=false
# Set to 1 only when the app is behind exactly one trusted HTTPS reverse proxy.
TRUST_PROXY=1

# Server-only secrets. Never prefix these with VITE_ or put them in frontend code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_TUTOR_MAX_TOKENS=1024
AI_TUTOR_TIMEOUT_MS=30000
AI_TUTOR_DAILY_LIMIT=20
# Optional current USD price per million tokens for the configured model.
# Leave empty to log tokens only; update both when changing the model.
ANTHROPIC_INPUT_USD_PER_MILLION=
ANTHROPIC_OUTPUT_USD_PER_MILLION=
